{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }} :: {{ .Shell }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": "┌─[ "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#ffb000",
          "template": "{{ .Path }}",
          "properties": {
            "style": "folder",
            "max_depth": 2,
            "folder_separator_icon": "/",
            "home_icon": "~"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " ]─[ "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#00c8b4",
          "template": "{{ .HEAD }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " ]"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#ff2e4d",
          "template": " [ {{ .String }} ]"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " [ {{ .FormattedMs }} ]",
          "properties": {
            "threshold": 500
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " [ go {{ .Full }} ]",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " [ node {{ .Full }} ]",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": " [ py {{ .Full }} ]",
          "properties": {
            "fetch_version": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#4a4d55",
          "template": "{{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ff2e4d",
          "foreground_templates": [
            "{{ if eq .Code 0 }}#ffb000{{ end }}"
          ],
          "template": "<b>└─╼</b> "
        }
      ]
    }
  ]
}
