#!/bin/bash
# Banner exibido ao abrir um terminal.
# Desative com: export CYBERDECK_BANNER=0

[[ ${CYBERDECK_BANNER:-1} == 0 ]] && exit 0
[[ -t 1 ]] || exit 0

# Cores do flavor ativo (padrão: amber)
CD_PRIMARY='255;176;0' CD_SECONDARY='0;200;180' CD_OVERLAY='74;77;88' CD_MUTED='125;128;142'
CYBERDECK_FLAVOR=amber
f="${CYBERDECK_DIR:-$HOME/.config/cyberdeck}/current/flavor.sh"
[[ -r $f ]] && source "$f"

FRAME="\033[38;2;${CD_OVERLAY}m"
DIM="\033[38;2;${CD_MUTED}m"
ACCENT="\033[1;38;2;${CD_PRIMARY}m"
SECOND="\033[38;2;${CD_SECONDARY}m"
OFF='\033[0m'

# O banner roda como script bash: $BASH_VERSION é sempre a versão do bash e
# $SHELL é o shell de login, então o shell de verdade é o processo pai.
shell_name="$(ps -o comm= -p "$PPID" 2>/dev/null)"
shell_name="${shell_name#-}"
[[ -n $shell_name ]] || shell_name="${SHELL##*/}"
shell_ver="$("$shell_name" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
[[ -n $shell_ver ]] || shell_ver="${BASH_VERSION%%(*}"
cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
rows="${LINES:-$(tput lines 2>/dev/null || echo 24)}"
now="$(date '+%Y-%m-%d %H:%M')"

printf '%b\n' \
  "${FRAME}▌${OFF} ${ACCENT}CYBERDECK${OFF} ${FRAME}//${OFF} ${SECOND}${USER}@${HOSTNAME%%.*}${OFF} ${DIM}· ${CYBERDECK_FLAVOR}${OFF}" \
  "${FRAME}▌${OFF} ${DIM}${shell_name} ${shell_ver} · ${now} · ${cols}x${rows}${OFF}" \
  "${FRAME}▌${OFF}"
